# ============================================================
# Model provider: "openai" (local prototyping) | "watsonx" (IBM)
# ============================================================
MODEL_PROVIDER=watsonx

# --- OpenAI (prototyping only, or optional last-resort fallback) ---
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL_ID=gpt-4o
# Off by default — set true only if you want GPT after IBM models fail
OPENAI_FALLBACK=false

# --- IBM watsonx.ai — same API key + project for ALL models below ---
# No extra Code Engine app or watsonx project needed for fallback.
IBM_WATSONX_API_KEY=your_ibm_cloud_api_key_here
IBM_WATSONX_PROJECT_ID=your_watsonx_project_id_here
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Primary voice (structured output + tools verified on watsonx)
WATSONX_MODEL_ID=ibm/granite-4-h-small
# Fallback voice — different model id, same URL/key/project (API only)
WATSONX_FALLBACK_MODEL_ID=meta-llama/llama-3-3-70b-instruct

# Vision (no Granite vision in region) — primary
WATSONX_VISION_MODEL_ID=meta-llama/llama-3-2-11b-vision-instruct
# Optional second vision model (same API). Leave empty to skip.
# WATSONX_FALLBACK_VISION_MODEL_ID=

# --- Groq Whisper (audio) + LLM text fallback when watsonx quota fails ---
GROQ_API_KEY=your_groq_key_here
GROQ_LLM_MODEL_ID=llama-3.1-8b-instant
GROQ_LLM_FALLBACK=true

# --- Tavily (optional web research on the USER topic) ---
TAVILY_API_KEY=your_tavily_key_here

# Optional: OPENAI_FALLBACK=true if Groq daily limit also exhausted
